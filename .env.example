# Copy this file to .env.local and fill in once your Shopify store exists.
# See README.md section "2. Set up Shopify (headless)" for how to get these.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=

# Optional: forwards every pre-order/waitlist submission to an external
# service (Zapier, Airtable, Klaviyo, etc). See README.md section 3.
LEADS_WEBHOOK_URL=
